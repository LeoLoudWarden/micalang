user = {"name": "mica", "tags": ["vm", "sandbox"], "level": 1}
user["level"] = 2

print("name:", user["name"])
print("level:", user["level"])
print("keys:", keys(user))
print("has tags:", "tags" in user)
print("no password:", "password" not in user)

try:
    print(user["missing"])
except key_error as e:
    print("caught:", e)

i = 0
names = keys(user)
while i < len(names):
    key = names[i]
    print(key, "=", user[key])
    i = i + 1
