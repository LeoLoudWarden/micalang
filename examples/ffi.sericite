# A parent VM grants functions to a child VM: capabilities travel explicitly along the creation chain

base_url = "https://api.example.com"

def endpoint(path):
    return base_url + "/" + path

def fake_http_get(url):
    # In a real scenario this is a host-injected network function; here a sericite function simulates a structured response
    return {"status": 200, "url": url, "body": "payload of " + url}

child_source = """
resp = fake_http_get(endpoint("users"))
print("status:", resp["status"])
print("url:", resp["url"])
if "body" in resp:
    print("body:", resp["body"])
"""

sub = VM(child_source, functions={"endpoint": endpoint, "fake_http_get": fake_http_get})
print(sub.run())
